pipeline {
  agent any

  stages {
    stage('Deploy') {
      steps {
        script {
          withCredentials([string(credentialsId: 'NOW_TOKEN', variable: 'NOW_TOKEN')]) {
            sh """
              export NODE_VERSION=18.16.0
              export NODE_DIR=\${WORKSPACE}/node-bin
              
              if [ ! -d "\${NODE_DIR}" ]; then
                curl -o node.tar.gz https://nodejs.org/dist/v\${NODE_VERSION}/node-v\${NODE_VERSION}-linux-x64.tar.gz
                mkdir -p \${NODE_DIR}
                tar -xzf node.tar.gz -C \${NODE_DIR} --strip-components=1
                rm node.tar.gz
              fi
              
              export PATH=\${NODE_DIR}/bin:\$PATH
              
              npm install -g vercel@latest
              
              DEPLOY_OUTPUT=\$(vercel webapp --token ${env.NOW_TOKEN} --yes)
              echo "\${DEPLOY_OUTPUT}"

              RESULT_URL=\$(echo "\${DEPLOY_OUTPUT}" | grep -o 'https://[^ ]*' | grep 'vercel.app' | tail -n 1)
              echo "URL de despliegue extraida: \${RESULT_URL}"
              echo "\${RESULT_URL}" > deployment_url.txt
            """
          }
        }
      }
    }

    stage('Acceptance Test') {
      steps {
        sh """
          RESULT_URL=\$(cat deployment_url.txt)
          echo "Ejecutando Acceptance Test sobre: \${RESULT_URL}/add/3/4"
          
          RESPONSE=\$(curl -sL "\${RESULT_URL}/add/3/4")
          echo "Respuesta del servidor: \${RESPONSE}"
          
          echo "\${RESPONSE}" | grep 7
          """
      }
    }
  }

  
}