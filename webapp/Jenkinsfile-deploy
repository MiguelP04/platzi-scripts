pipeline {
  agent any
  
  tools {
    nodejs '18.16.0' // Usamos una versión moderna de Node compatible con Vercel actual
  }

  stages {
    stage('Deploy') {
      steps {
        script {
          withCredentials([string(credentialsId: 'NOW_TOKEN', variable: 'NOW_TOKEN')]) {
            // 1. Instalamos la última versión del CLI de Vercel globalmente
            sh "npm install -g vercel@latest"
            
            // 2. Ejecutamos el despliegue moderno sobre la carpeta webapp
            sh "vercel webapp --token ${env.NOW_TOKEN} --scope miguel09112004-3023 --yes --confirm"
          }
        }
      }
    }
  }
}